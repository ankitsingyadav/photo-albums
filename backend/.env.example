# Copy to backend/.env and adjust. Nothing here is a real secret.
# (Login sessions use random tokens stored hashed in the database, so there is no signing secret to manage.)

# Port the API listens on
PORT=4000

# SQLite database file
DATABASE_PATH=./data/app.db

# Folder where originals and thumbnails are stored
UPLOAD_DIR=./data/uploads

# Upload limits
MAX_UPLOAD_MB=15
MAX_FILES_PER_UPLOAD=20

# bcrypt cost for password hashing. Default: 10 in development, 12 when NODE_ENV=production.
# BCRYPT_ROUNDS=12

# The login cookie is only sent over HTTPS when this is true.
# Default: true when NODE_ENV=production, false otherwise.
# Set it to false ONLY to try a production build over plain http://localhost.
# COOKIE_SECURE=true

# How many reverse proxies (nginx, a hosting platform...) sit in front of the app.
# Leave unset when the app is reached directly. If you run behind ONE proxy, set 1 so
# login rate limits see each visitor's real IP address instead of the proxy's.
# Never set this when there is no proxy: visitors could then fake their IP address.
# TRUST_PROXY=1

# A login ends after this many days without use, and never lasts more than the maximum.
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30

# Built frontend that the API serves in production (optional)
FRONTEND_DIST=../frontend/dist
